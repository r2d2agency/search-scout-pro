# Banco de dados PostgreSQL
DATABASE_URL=postgresql://user:password@postgres:5432/leads_db

# JWT Secret (gere uma chave segura)
JWT_SECRET=sua_chave_secreta_aqui_mude_em_producao

# URL do Frontend (para CORS)
FRONTEND_URL=https://seu-dominio.com

# Porta da API
PORT=3000

# Ambiente
NODE_ENV=production

# Firecrawl API (para busca no Instagram)
FIRECRAWL_API_KEY=sua_chave_firecrawl_aqui
